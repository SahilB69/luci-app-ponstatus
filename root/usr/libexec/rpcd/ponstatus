#!/bin/sh
# ponstatus: rpcd exec plugin for luci-app-ponstatus.
#
# Reads live optical-module data from a ZTE ONT ("opticaltst -getpara" over its telnet
# port) and serves it as JSON:   ubus call ponstatus get ['{"force":true}']
#
# Design:
#  - "get" answers from a small cache in /tmp (no process is forked on a cache hit).
#  - A stale cache starts ONE background refresh (mkdir lock) and waits up to WAIT seconds
#    for it, so callers get fresh data but never block for long, however many viewers poll.
#  - The ONT session is scripted expect-style over a fifo, so it ends as soon as the data
#    has arrived (about 2 s) and every stage has a timeout. Needs only busybox nc + mkfifo.
#  - Errors are returned as short codes (unreachable, auth, config, nodata, tools).

TTL=5
WAIT=5
STALE_LOCK=40

DIR=${PONSTATUS_DIR:-/tmp/ponstatus}
LIB=${PONSTATUS_LIB:-/lib/functions.sh}
DATA=$DIR/data; ERR=$DIR/err; LOCK=$DIR/lock
PROMPT='(^|[^#$])[#$] *$'
umask 077

now() { read -r _up _ < /proc/uptime; NOW=${_up%%.*}; }
nap() { sleep 0.2 2>/dev/null || sleep 1; }

read_state() {
	HAVE=0; DTS=-100000; ETS=-100000; ECODE=
	if [ -r "$DATA" ] && read -r _d TEMP VOLT BIAS TX RX < "$DATA" && [ -n "$RX" ]; then
		HAVE=1; DTS=$_d
	fi
	if [ -r "$ERR" ] && read -r _e _c < "$ERR"; then ETS=$_e; ECODE=$_c; fi
}

emit() {
	now
	if [ "$HAVE" = 1 ]; then
		_age=$((NOW - DTS)); [ "$_age" -lt 0 ] && _age=0
		printf '{"ok":true,"age":%d,"temperature":%s,"voltage":%s,"bias_current":%s,"tx_power":%s,"rx_power":%s' \
			"$_age" "$TEMP" "$VOLT" "$BIAS" "$TX" "$RX"
		[ "$ETS" -gt "$DTS" ] && printf ',"error":"%s"' "$ECODE"
		printf '}\n'
	elif [ -n "$ECODE" ]; then
		printf '{"ok":false,"error":"%s"}\n' "$ECODE"
	else
		printf '{"ok":false,"pending":true}\n'
	fi
}

record_error() { now; echo "$NOW $1" > "$ERR.tmp" && mv "$ERR.tmp" "$ERR"; }

take_lock() {
	if mkdir "$LOCK" 2>/dev/null; then now; echo "$NOW" > "$LOCK/ts"; return 0; fi
	_t=; { read -r _t < "$LOCK/ts"; } 2>/dev/null; now
	[ -n "$_t" ] && [ $((NOW - _t)) -gt "$STALE_LOCK" ] || return 1
	rm -rf "$LOCK"
	mkdir "$LOCK" 2>/dev/null && { echo "$NOW" > "$LOCK/ts"; return 0; }
	return 1
}

wait_refresh() {
	now; _end=$((NOW + WAIT))
	while [ -d "$LOCK" ]; do
		now; [ "$NOW" -ge "$_end" ] && return
		nap
	done
}

clean() { tr -cd '\11\12\40-\176' < "$OUT"; }

wait_for() {
	now; _end=$((NOW + $2))
	while :; do
		if [ -n "$3" ]; then clean | tail -n 1 | grep -qE "$1"; else clean | grep -qE "$1"; fi && return 0
		kill -0 "$NC" 2>/dev/null || return 1
		now; [ "$NOW" -ge "$_end" ] && return 1
		nap
	done
}

send() { printf '%s\r\n' "$1" >&3; }

session() {
	SERR=; RAW=
	command -v nc >/dev/null 2>&1 && command -v mkfifo >/dev/null 2>&1 || { SERR=tools; return 1; }
	IN=$DIR/in.$$; OUT=$DIR/out.$$
	mkfifo "$IN" 2>/dev/null || { SERR=tools; return 1; }
	: > "$OUT"
	exec 3<> "$IN"
	nc "$HOST" "$PORT" < "$IN" >> "$OUT" 2>/dev/null &
	NC=$!

	if ! wait_for "ogin: *\$|$PROMPT" 5 last; then
		if [ -s "$OUT" ]; then SERR=nodata; else SERR=unreachable; fi
		return 1
	fi
	if clean | tail -n 1 | grep -qE 'ogin: *$'; then
		[ -n "$USER" ] || { SERR=config; return 1; }
		: > "$OUT"; send "$USER"
		wait_for 'assword: *$' 3 last || { SERR=nodata; return 1; }
		: > "$OUT"; send "$PASS"
		wait_for "$PROMPT|ogin: *\$" 5 last
		clean | tail -n 1 | grep -qE "$PROMPT" || { SERR=auth; return 1; }
	fi
	: > "$OUT"; send 'opticaltst -getpara'
	wait_for 'Close optical_dev|RFTXPower=' 5
	RAW=$(clean)
	send exit
	return 0
}

cleanup() {
	exec 3>&-
	[ -n "$NC" ] && { kill "$NC" 2>/dev/null; wait "$NC" 2>/dev/null; }
	rm -f "$IN" "$OUT" "$DATA.tmp" "$ERR.tmp"
	rm -rf "$LOCK"
}

val() { echo "$RAW" | awk -F= -v k="optical $1" '{ gsub(/^ +/, "", $1) } $1 == k { print $2 + 0; exit }'; }

refresh() {
	trap cleanup EXIT
	trap 'exit 1' HUP INT TERM
	. "$LIB"
	config_load ponstatus
	config_get HOST main host 192.168.1.1
	config_get PORT main port 23
	config_get USER main user
	config_get PASS main pass
	case "$HOST" in ''|-*|*[!A-Za-z0-9.:_-]*) record_error config; return ;; esac
	case "$PORT" in ''|*[!0-9]*) record_error config; return ;; esac

	session || { record_error "$SERR"; return; }

	T=$(val temp); V=$(val SupplyVoltage); B=$(val TXBiasCurrent); TXR=$(val TXPower); RXR=$(val RXPower)
	if [ -z "$T" ] || [ -z "$V" ] || [ -z "$B" ] || [ -z "$TXR" ] || [ -z "$RXR" ]; then record_error nodata; return; fi
	case "$T$V$B$TXR$RXR" in *[!0-9-]*) record_error nodata; return ;; esac

	set -- $(awk -v t="$T" -v v="$V" -v b="$B" -v tx="$TXR" -v rx="$RXR" '
		function log10(x, e, y, z, s, i) {
			e = 0
			while (x >= 3.1623) { x /= 10; e++ }
			while (x < 0.31623) { x *= 10; e-- }
			y = (x - 1) / (x + 1); z = y * y; s = 0
			for (i = 1; i <= 25; i += 2) { s += y / i; y *= z }
			return e + 2 * s / 2.302585092994046
		}
		function dbm(x) { return x > 0 ? sprintf("%.2f", 10 * log10(x / 10000)) : "null" }
		BEGIN { if (t > 32767) t -= 65536
			printf "%.1f %.3f %.1f %s %s", t / 256, v / 10000, b * 2 / 1000, dbm(tx), dbm(rx) }' 2>/dev/null)
	[ $# -eq 5 ] || { record_error nodata; return; }
	now
	echo "$NOW $1 $2 $3 $4 $5" > "$DATA.tmp" && mv "$DATA.tmp" "$DATA"
	rm -f "$ERR"
}

get() {
	[ -d "$DIR" ] || mkdir -p "$DIR" || { echo '{"ok":false,"error":"tools"}'; return; }
	read_state; now
	_last=$DTS; [ "$ETS" -gt "$_last" ] && _last=$ETS
	if [ "$FORCE" = 1 ] || [ $((NOW - _last)) -ge "$TTL" ]; then
		if take_lock; then ( refresh ) </dev/null >/dev/null 2>&1 & fi
		wait_refresh
		read_state
	fi
	emit
}

case "$1" in
list) echo '{"get":{"force":true}}' ;;
call)
	case "$2" in
	get)
		read -r ARGS
		case "$ARGS" in *'"force":true'*|*'"force": true'*) FORCE=1 ;; esac
		get ;;
	*) echo '{"error":"unknown method"}' ;;
	esac ;;
esac
